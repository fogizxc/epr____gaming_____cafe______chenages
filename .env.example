# ------------------------------------------------------------
# Core application
# ------------------------------------------------------------
NODE_ENV=production
PORT=3000
APP_URL=

# Business-local clock used for bookings, check-in windows and lifecycle jobs.
# India default: Asia/Kolkata (UTC+05:30).
BUSINESS_TIMEZONE=Asia/Kolkata
BOOKING_CHECKIN_GRACE_MINUTES=15
BOOKING_NO_SHOW_GRACE_MINUTES=15

# F&B online-payment reservation lifecycle.
# Pending orders reserve stock; unpaid reservations expire and release stock.
FNB_PAYMENT_EXPIRY_MINUTES=15
FNB_LIFECYCLE_INTERVAL_MS=30000

# ------------------------------------------------------------
# MongoDB Atlas (production persistence)
# ------------------------------------------------------------
MONGODB_URI=
MONGODB_DB_NAME=bytes_brew_epr
MONGODB_APP_NAME=gaming-cafe-epr
MONGODB_MAX_POOL_SIZE=30
MONGODB_MIN_POOL_SIZE=2
MONGODB_MAX_IDLE_TIME_MS=60000
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
MONGODB_CONNECT_TIMEOUT_MS=5000
MONGODB_SOCKET_TIMEOUT_MS=20000
MONGODB_WAIT_QUEUE_TIMEOUT_MS=10000

# Session/JWT signing secret. Generate a long random value (32+ chars).
AUTH_SECRET=

# Optional internal API key for protected operational/integration endpoints.
INTERNAL_API_KEY=

# ------------------------------------------------------------
# First-admin bootstrap (never commit real values)
# ------------------------------------------------------------
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_NAME=Bytes & Brew Administrator
ADMIN_BOOTSTRAP_STAFF_CODE=

# ------------------------------------------------------------
# Google Gemini (server-side only)
# ------------------------------------------------------------
GEMINI_API_KEY=

# ------------------------------------------------------------
# Brevo transactional email
# ------------------------------------------------------------
# BREVO_FROM_EMAIL MUST be a verified Brevo sender. There is intentionally no
# hardcoded sender fallback in production configuration.
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=
BREVO_SMTP_KEY=
BREVO_FROM_EMAIL=
BREVO_FROM_NAME=Bytes & Brew Gaming Café

# ------------------------------------------------------------
# Google Sheets integration
# ------------------------------------------------------------
GOOGLE_SHEETS_WEBHOOK_URL=
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_WEBHOOK_SECRET=

# ------------------------------------------------------------
# Google Forms tournament integration
# ------------------------------------------------------------
# Apps Script forwards verified form submissions to this endpoint.
GOOGLE_FORMS_WEBHOOK_SECRET=

# ------------------------------------------------------------
# Payments
# ------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ------------------------------------------------------------
# Operational security
# ------------------------------------------------------------
TRUST_PROXY=false
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120
